@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4"
     id="moduloProductos"
     data-listar="@Url.Action("ObtenerProductos", "Producto")"
     data-detalle="@Url.Action("ObtenerProductoPorId", "Producto")">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Productos médicos</h2>
            <p class="text-muted">Administración de productos</p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#modalCrearProducto">
            Nuevo producto
        </button>
    </div>

    <div class="card">
        <div class="card-header">
            Lista de productos
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="tblProductos"
                       class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Categoría</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    @await Html.PartialAsync(
        "_Create",
        new Practica_2.Application.Dtos.ProductoDto())

    @await Html.PartialAsync(
        "_Edit",
        new Practica_2.Application.Dtos.ProductoDto())

    <form id="formEliminarProducto"
          asp-controller="Producto"
          asp-action="EliminarProducto"
          method="post">

        <input type="hidden" name="id" />

    </form>
</div>

@section Scripts {
    <script src="~/js/producto.js"
            asp-append-version="true"></script>
}
